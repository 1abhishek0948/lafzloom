<!DOCTYPE html>
{% set lang_code = request.LANGUAGE_CODE or 'en' %}
<html lang="{{ lang_code }}" dir="{% if lang_code.startswith('ur') %}rtl{% else %}ltr{% endif %}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="{{ seo_robots }}">
  <meta name="description" content="{{ seo_description }}">
  {% if seo_keywords %}<meta name="keywords" content="{{ seo_keywords }}">{% endif %}
  <meta name="author" content="{{ seo_author }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" href="{{ static('images/favicon.ico') }}" type="image/x-icon">
  <link rel="apple-touch-icon" href="{{ static('images/logo.png') }}">
  <meta property="og:type" content="{{ seo_og_type }}">
  <meta property="og:title" content="{{ seo_title }}">
  <meta property="og:description" content="{{ seo_description }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:site_name" content="{{ seo_site_name }}">
  <meta property="og:image" content="{{ seo_image_url }}">
  <meta property="og:locale" content="{{ seo_og_locale }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ seo_title }}">
  <meta name="twitter:description" content="{{ seo_description }}">
  <meta name="twitter:image" content="{{ seo_image_url }}">
  {% if google_site_verification %}<meta name="google-site-verification" content="{{ google_site_verification }}">{% endif %}
  {% if bing_site_verification %}<meta name="msvalidate.01" content="{{ bing_site_verification }}">{% endif %}

  <title>{% block title %}{{ seo_title }}{% endblock %}</title>
  {% if seo_jsonld_extra %}
    <script type="application/ld+json">{{ seo_jsonld_extra | tojson }}</script>
  {% else %}
    <script type="application/ld+json">{{ {
      '@context': 'https://schema.org',
      '@type': seo_schema_type,
      'name': seo_site_name,
      'url': canonical_url,
      'description': seo_description,
      'inLanguage': lang_code
    } | tojson }}</script>
  {% endif %}
  {% if seo_breadcrumbs %}
    <script type="application/ld+json">{{ seo_breadcrumbs | breadcrumb_jsonld(seo_home_url) }}</script>
  {% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="{{ static('css/styles.css') }}">
</head>
<body class="bg-ink text-slate-100 min-h-screen">
  <div class="aurora"></div>
  {% include 'partials/navbar.jinja' %}

  {% if messages %}
    <div class="max-w-6xl mx-auto px-4 mt-4">
      {% for message in messages %}
        <div class="toast">{{ message }}</div>
      {% endfor %}
    </div>
  {% endif %}

  <main id="main-content" class="max-w-6xl mx-auto px-4 py-10">
    {% block content %}{% endblock %}
  </main>

  <div class="hidden">
    {{ csrf_input }}
  </div>

  {% include 'partials/footer.jinja' %}

  {% set i18n_strings = {
    'languageLabels': {'hi': t('Hindi'), 'en': t('English'), 'ur': t('Urdu')},
    'translateTo': t('Translate → {language}'),
    'translating': t('Translating...'),
    'translationUnavailable': t('Translation service unavailable. Configure the provider in .env.'),
    'loginToLike': t('Please login to like shayaris.'),
    'loginToSave': t('Please login to save shayaris.'),
    'showPassword': t('Show password'),
    'hidePassword': t('Hide password'),
    'saved': t('Saved'),
    'save': t('Save'),
    'copied': t('Copied'),
    'copy': t('Copy'),
    'copyFailed': t('Copy failed.'),
    'linkCopied': t('Link copied to clipboard.')
  } %}
  <script>
    window.LAFZLOOM_I18N = {{ i18n_strings | tojson }};
  </script>
  <script src="{{ static('js/app.js') }}" defer></script>
  {% block extra_js %}{% endblock %}
</body>
</html>
