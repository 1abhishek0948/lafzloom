{% extends 'base.jinja' %}

{% block title %}{{ seo_title }}{% endblock %}

{% block content %}
<section class="max-w-2xl" aria-labelledby="server-error-title">
  <p class="tag">500</p>
  <h1 id="server-error-title" class="text-3xl sm:text-4xl font-display">Something went wrong</h1>
  <p class="mt-4 text-slate-300">Lafzloom could not complete that request. Please try again or return to a public page.</p>
  <div class="mt-6 flex flex-wrap gap-3">
    <a class="btn-primary" href="{{ url('home') }}">Go to Lafzloom home</a>
    <a class="btn-ghost" href="{{ url('shayari:list') }}">Browse shayari</a>
  </div>
</section>
{% endblock %}
