{% if page_obj and page_obj.paginator.num_pages > 1 %}
<nav class="mt-10 flex items-center justify-center gap-4" aria-label="Pagination">
  {% if page_obj.has_previous() %}
    <a class="btn-ghost" rel="prev" href="?page={{ page_obj.previous_page_number() }}">Previous page</a>
  {% endif %}
  <span class="text-sm text-slate-300">Page {{ page_obj.number }} of {{ page_obj.paginator.num_pages }}</span>
  {% if page_obj.has_next() %}
    <a class="btn-ghost" rel="next" href="?page={{ page_obj.next_page_number() }}">Next page</a>
  {% endif %}
</nav>
{% endif %}
